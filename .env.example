# Copy to .env. .env is never committed and never web-served.
APP_NAME="RAI-X"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/RAIX/dev
# The URL segment the platform is mounted under, when the folder above
# public/ is reachable too. Under plain XAMPP the root .htaccess maps
# /RAIX/dev/... onto /RAIX/public/..., so this must read 'dev' and must
# match APP_URL's last segment. Empty when public/ IS the document root.
# Apps listed in config/apps.php 'unmounted' are served WITHOUT it (see README).
APP_MOUNT=dev
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=raix
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# The admin console has no sign-in. It acts as one administrator record:
# this names it by email, and empty means the earliest active one.
ADMIN_EMAIL=

# The shared Admin PIN, and the account it signs in as, are NOT set here —
# both live only in the database and are set at Admin › Settings.

# Log retention (config/logging.php): the web server's and PHP's log folders,
# trimmed to 30 days with email addresses redacted. Empty where the host
# manages its own log retention.
SERVER_LOG_DIR=
PHP_LOG_DIR=
